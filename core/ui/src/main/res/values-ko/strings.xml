<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="action_grant_permission">권한 허용</string>
    <string name="action_open_settings">설정 열기</string>
    <string name="action_cancel">취소</string>

    <string name="permission_rationale_title_default">권한 필요</string>
    <string name="permission_rationale_message_default">이 기능을 사용하려면 권한이 필요합니다. 허용해 주세요!</string>

    <string name="permission_rationale_title_multiple">여러 권한 필요</string>
    <string name="permission_rationale_message_multiple">이 기능이 올바르게 작동하려면 몇 가지 권한이 필요합니다. 다음 단계에서 허용해 주세요.</string>

    <string name="permission_rationale_title_camera">카메라 권한</string>
    <string name="permission_rationale_message_camera">사진이나 동영상을 촬영하려면 카메라 접근 권한이 필요합니다.</string>

    <string name="permission_rationale_title_mic">마이크 권한</string>
    <string name="permission_rationale_message_mic">음성을 녹음하려면 마이크 접근 권한이 필요합니다.</string>

    <string name="permission_rationale_title_location">위치 권한</string>
    <string name="permission_rationale_message_location">가장 정확한 서비스를 제공하려면 위치 접근 권한이 필요합니다.</string>

    <string name="permission_rationale_title_storage">저장소 권한</string>
    <string name="permission_rationale_message_storage">파일을 업로드하거나 저장하려면 사진 및 미디어 접근 권한이 필요합니다.</string>

    <string name="permission_settings_title_default">권한 거부됨</string>
    <string name="permission_settings_message_default">이전에 이 권한을 거부하셨습니다. 계속하려면 설정을 열고 수동으로 허용해 주세요.</string>

    <string name="permission_settings_title_multiple">권한 누락</string>
    <string name="permission_settings_message_multiple">몇 가지 필수 권한이 영구적으로 거부되었습니다. 설정을 열고 접근을 허용해 주세요.</string>

    <string name="permission_settings_title_camera">카메라 접근 불가</string>
    <string name="permission_settings_message_camera">카메라 접근이 차단되었습니다. 설정을 열고 권한으로 이동하여 카메라 접근을 허용해 주세요.</string>

    <string name="permission_settings_title_mic">마이크 접근 불가</string>
    <string name="permission_settings_message_mic">마이크 접근이 차단되었습니다. 설정을 열고 권한으로 이동하여 마이크 접근을 허용해 주세요.</string>

    <string name="permission_settings_title_location">위치 비활성화됨</string>
    <string name="permission_settings_message_location">위치 접근이 차단되었습니다. 설정을 열고 "항상 허용" 또는 "앱 사용 중에만 허용"을 선택해 주세요.</string>

    <string name="permission_settings_title_storage">저장소 비활성화됨</string>
    <string name="permission_settings_message_storage">저장소 접근이 차단되었습니다. 이 권한을 부여하려면 설정을 열어 주세요.</string>
</resources>